   3.992583462276991*^9}, {3.992583537556251*^9, 3.992583613633211*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"ce667ade-064c-4739-bc74-1a40bb1a1073"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"EigenvalueList", "=", 
   RowBox[{"Reverse", "[", 
    RowBox[{"Eigenvalues", "[", "dnm", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EigenvectorList", "=", 
   RowBox[{"Reverse", "[", 
    RowBox[{"Eigenvectors", "[", "dnm", "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EigenState", "[", "r_", "]"}], "[", "x_", "]"}], ":=", 
  RowBox[{"Plus", "@@", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"EigenvectorList", "[", 
        RowBox[{"[", 
         RowBox[{"(", 
          RowBox[{"r", "+", "1"}], ")"}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"l", "+", "1"}], "]"}], "]"}], 
      RowBox[{
       RowBox[{"phi", "[", "l", "]"}], "[", "x", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "0", ",", "dim"}], "}"}]}], 
    "]"}]}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.992579775133499*^9, 3.992579811147142*^9}, {
  3.992582491714634*^9, 3.9925825006103354`*^9}, {3.992582615313052*^9, 
