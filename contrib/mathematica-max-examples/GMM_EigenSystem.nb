Cell[TextData[{
 "For a given initial state (defined as a continuous function ",
 StyleBox["InitialState[x]",
  FontSlant->"Italic"],
 " on ",
 StyleBox["R",
  FontSlant->"Italic"],
 ") we obtain its ",
 StyleBox["dim+1",
  FontSlant->"Italic"],
 " coefficients with respect to the Eigenstate-Basis as follows:\nAs an \
example we use the deflected ground state by ",
 StyleBox["k",
  FontSlant->"Italic"],
 " fifths: \[LineSeparator]",
 StyleBox["InitialState[x_] = EigenState[0][x-shift] for shift = k Pi/6\n",
  FontSlant->"Italic"],
 "For the numerical Integration it is important to include",
 StyleBox[" \"?NumericQ\" ",
  FontSlant->"Italic"],
 "into the definition of ",
 StyleBox["InitialState[x_]",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.992573034967477*^9, 3.9925730760105124`*^9}, {
