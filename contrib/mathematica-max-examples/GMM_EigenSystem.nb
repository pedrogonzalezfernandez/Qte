Cell[TextData[{
 "The following cell defines the normalised Hermite-functions  ",
 StyleBox["phi[m_][x_]",
  FontSlant->"Italic"],
 ", which form an orthonormal Eigenbasis for the Harmonic oscillator. And we \
follow equation (35) in order to express the eigenstates of the perturbated \
oscillator with respect to this basis. With (37) we use them together with \
the pertubation potential ",
 StyleBox["W[x] ",
  FontSlant->"Italic"],
 "to numerically calculate entries of the potentially infinite-dimensional \
matrix ",
 StyleBox["w_nm",
  FontSlant->"Italic"],
 ". The integrand for these calulations is ",
 StyleBox["w[n_][m_][x_]",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.992573034967477*^9, 3.9925730760105124`*^9}, {
   3.992573245746047*^9, 3.992573297969474*^9}, {3.992573375103759*^9, 
   3.992573444666151*^9}, {3.99257384784009*^9, 3.992573893912764*^9}, 
   3.992574048682549*^9, 3.992574081843865*^9, {3.992575101736039*^9, 
   3.992575184341875*^9}, {3.992575618728243*^9, 3.992575716246941*^9}, {
   3.992576451183053*^9, 3.992576457653707*^9}, {3.992577470158874*^9, 
   3.992577472754449*^9}, {3.992577552754883*^9, 3.992577606022666*^9}, {
   3.992577696807067*^9, 3.99257770400885*^9}, {3.992577765404036*^9, 
   3.9925778198302526`*^9}, 3.992578096596713*^9, {3.992579049818428*^9, 
   3.99257908576667*^9}, {3.992579151550301*^9, 3.992579195467484*^9}, {
   3.992579296985524*^9, 3.992579325799858*^9}, {3.9925793631541033`*^9, 
   3.992579363809713*^9}, {3.992579394687345*^9, 3.992579402683174*^9}, {
   3.99258320409077*^9, 3.992583282626392*^9}, {3.992583397462861*^9, 
   3.992583402980733*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"18ec45e4-e6d3-4f78-8acc-819d356c2421"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"phi", "[", "m_", "]"}], "[", "x_", "]"}], ":=", 
   FractionBox[
    RowBox[{
     RowBox[{"E0", "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "4"}], ")"}]}], 
     RowBox[{"HermiteH", "[", 
      RowBox[{"m", ",", 
       RowBox[{
        SqrtBox["E0"], "x"}]}], "]"}], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{"E0", " ", 
         SuperscriptBox["x", "2"]}], "2"]}]]}], 
    SqrtBox[
     RowBox[{
      SuperscriptBox["2", "m"], " ", 
      RowBox[{"m", "!"}], " ", 
      SqrtBox["\[Pi]"]}]]]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"w", "[", "n_", "]"}], "[", "m_", "]"}], "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{"phi", "[", "n", "]"}], "[", "x", "]"}], 
   RowBox[{"W", "[", "x", "]"}], " ", 
   RowBox[{
    RowBox[{"phi", "[", "m", "]"}], "[", "x", "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.9925774995765467`*^9, 3.992577515835071*^9}, {
  3.992579043055105*^9, 3.99257907396597*^9}},
 CellLabel->
  "In[744]:=",ExpressionUUID->"be5d9a42-a9bd-4021-9425-5e28dfe182e4"],

Cell[TextData[{
 "We choose a dimension ",
 StyleBox["dim+1",
  FontSlant->"Italic"],
 " for a finite-dimensional approximation as well as a finite domain ",
 StyleBox["(xmin, xmax) ",
  FontSlant->"Italic"],
 "for the integration. The numerically integrated coefficients are then \
stored in a matrix ",
 StyleBox["dnm = enm + wnm",
  FontSlant->"Italic"],
 ". "
}], "Text",
 CellChangeTimes->{{3.992573034967477*^9, 3.9925730760105124`*^9}, {
   3.992573245746047*^9, 3.992573297969474*^9}, {3.992573375103759*^9, 
   3.992573444666151*^9}, {3.99257384784009*^9, 3.992573893912764*^9}, 
   3.992574048682549*^9, 3.992574081843865*^9, {3.992575101736039*^9, 
   3.992575184341875*^9}, {3.992575618728243*^9, 3.992575716246941*^9}, {
   3.992576451183053*^9, 3.992576457653707*^9}, {3.992577470158874*^9, 
   3.992577472754449*^9}, {3.992577552754883*^9, 3.992577606022666*^9}, {
   3.992577696807067*^9, 3.99257770400885*^9}, {3.992577765404036*^9, 
   3.9925778198302526`*^9}, {3.992578096596713*^9, 3.9925781154360228`*^9}, {
   3.992578884884571*^9, 3.992579012135736*^9}, 3.992579047220299*^9, {
   3.9925794446227818`*^9, 3.9925794761249933`*^9}, {3.992579521520444*^9, 
   3.992579659530242*^9}, {3.992582708412039*^9, 3.992582770986973*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"9b0bec63-7e0e-47a6-a70d-6f0cf293fec1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"dim", "=", "30"}], "\[IndentingNewLine]", 
 RowBox[{"xmin", "=", 
  RowBox[{"-", "10"}]}], "\[IndentingNewLine]", 
 RowBox[{"xmax", "=", "10"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wnm", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"NIntegrate", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"w", "[", "n", "]"}], "[", "m", "]"}], "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], "]"}], "//", "N"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "dim"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", "dim"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"enm", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", "E0", " ", "n"}], " ", "+", "E0"}], ")"}], 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"n", ",", "m"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "dim"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"m", ",", "0", ",", "dim"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dnm", "=", 
   RowBox[{"enm", "+", "wnm"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992579775133499*^9, 3.992579811147142*^9}, {
  3.992582491714634*^9, 3.9925825006103354`*^9}, {3.992582615313052*^9, 
  3.992582698365011*^9}, {3.992582781117552*^9, 3.9925827884696302`*^9}, {
  3.992582888486299*^9, 3.992582897725738*^9}, {3.99258630065993*^9, 
