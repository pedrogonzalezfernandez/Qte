Notebook[{
Cell["\<\
This notebook implements numerical calculations from the 2025 musmat-article\
\[LineSeparator]\[OpenCurlyDoubleQuote]Unified musical quantum models for \
tonal attraction\[CloseCurlyDoubleQuote] by Peter beim Graben and Thomas Noll\
\[LineSeparator]https://musmat.org/journal/v9/01-beim-Graben-Noll.pdf
The results are formated for export and usage in a companion Max/MSP patch.\
\>", "Text",
 CellChangeTimes->{{3.992573034967477*^9, 3.9925730760105124`*^9}, {
  3.992573245746047*^9, 3.992573297969474*^9}, {3.99257349593828*^9, 
  3.992573522643299*^9}, {3.992573552897571*^9, 3.9925735536010857`*^9}, {
  3.9925759812165327`*^9, 3.992576017762076*^9}, {3.992576048106964*^9, 
  3.992576090352356*^9}, {3.992576120842888*^9, 3.992576286020108*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"16dee9e6-184a-4fa7-8745-c8d752c462b7"],

Cell[CellGroupData[{

Cell[BoxData["ClearAll"], "Input",
 CellChangeTimes->{{3.992574217595543*^9, 3.992574220874707*^9}, {
  3.992576037157864*^9, 
  3.992576038468554*^9}},ExpressionUUID->"1bf440c5-89ca-4d9a-b0d7-\
b4e0f5935c89"],

Cell[BoxData["ClearAll"], "Output",
 CellChangeTimes->{3.992574229066717*^9},
 CellLabel->
  "Out[686]=",ExpressionUUID->"48f245d9-b818-4c1d-ab7e-d46507e0b9b4"]
}, Open  ]],

Cell[TextData[{
 "A normalized Gaussian ",
 StyleBox["nu",
  FontSlant->"Italic"],
 " with mean ",
 StyleBox["mean",
  FontSlant->"Italic"],
 " and variance ",
 StyleBox["sigma^2\n",
  FontSlant->"Italic"],
 "a Gaussian Mixture from three components (cf. equations (2) and (1) of the \
musmat-article)"
}], "Text",
 CellChangeTimes->{{3.992573034967477*^9, 3.9925730760105124`*^9}, {
  3.992573245746047*^9, 3.992573297969474*^9}, {3.99257349593828*^9, 
  3.992573522643299*^9}, {3.992573552897571*^9, 3.9925735536010857`*^9}, {
  3.9925759812165327`*^9, 3.992576017762076*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"0a167193-b9f0-4399-8fb8-c6569d93f21e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nu", "[", 
    RowBox[{"sigma_", ",", "mean_"}], "]"}], "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"2", " ", "Pi", " ", 
      RowBox[{"sigma", "^", "2"}]}], "]"}]}], 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "/", "2"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "mean"}], ")"}], "/", "sigma"}], ")"}], "^", 
      "2"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pMix", "[", "sigma_", "]"}], "[", 
    RowBox[{"{", 
     RowBox[{
     "a_", ",", "b_", ",", "c_", ",", "alpha_", ",", "beta_", ",", "gamma_"}],
      "}"}], "]"}], "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"alpha", " ", 
    RowBox[{
     RowBox[{"nu", "[", 
      RowBox[{"sigma", ",", "a"}], "]"}], "[", "x", "]"}]}], "+", 
   RowBox[{"beta", " ", 
    RowBox[{
     RowBox[{"nu", "[", 
      RowBox[{"sigma", ",", "b"}], "]"}], "[", "x", "]"}]}], "+", 
   RowBox[{"gamma", " ", 
    RowBox[{
     RowBox[{"nu", "[", 
      RowBox[{"sigma", ",", "c"}], "]"}], "[", "x", "]"}]}]}]}]}], "Input",
 CellChangeTimes->{{3.992573034967477*^9, 3.9925730360662413`*^9}, {
  3.992573072569222*^9, 3.9925730861847067`*^9}, {3.992573526732733*^9, 
  3.992573527359066*^9}, {3.992573762811573*^9, 3.992573823687057*^9}, {
  3.99257411801254*^9, 3.992574118676441*^9}},
 CellLabel->
  "In[687]:=",ExpressionUUID->"5785f723-edd5-420d-b4f9-6093ed0558ec"],

Cell[TextData[{
 "In our key example, the three mean values ",
 StyleBox["a, b, c ",
  FontSlant->"Italic"],
 "and coefficients ",
 StyleBox["alpha, beta, gamma",
  FontSlant->"Italic"],
 " and the deviation ",
 StyleBox["sigma ",
  FontSlant->"Italic"],
 "are as follows: (c.f. plot in Figure 4a of the article and the text below \
it)"
}], "Text",
 CellChangeTimes->{{3.992573034967477*^9, 3.9925730760105124`*^9}, {
   3.992573245746047*^9, 3.992573297969474*^9}, {3.992573375103759*^9, 
   3.992573444666151*^9}, {3.99257384784009*^9, 3.992573893912764*^9}, 
   3.992574048682549*^9, 3.992574081843865*^9, {3.992576364150846*^9, 
   3.992576383672917*^9}, {3.992576430222308*^9, 3.992576464387609*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"42711cb6-cd72-4c11-82bf-5a22ae43dc9f"],

Cell[BoxData[{
 RowBox[{"sigma", "=", 
  RowBox[{
   RowBox[{"Pi", " ", "/", 
    RowBox[{"(", 
     RowBox[{"6", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", 
        RowBox[{"Log", "[", "2", "]"}]}], "]"}]}], ")"}]}], "//", 
   "N"}]}], "\[IndentingNewLine]", 
 RowBox[{"a", "=", 
  RowBox[{"0", " ", 
   RowBox[{"(", 
    RowBox[{"Pi", "/", "6"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"b", "=", 
  RowBox[{"1", " ", 
   RowBox[{"(", 
    RowBox[{"Pi", "/", "6"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"c", "=", 
  RowBox[{"4", 
   RowBox[{"(", 
    RowBox[{"Pi", "/", "6"}], ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"alpha", " ", "=", " ", 
  "0.4874675571530851`"}], "\[IndentingNewLine]", 
 RowBox[{"beta", " ", "=", "0.2035869120568771`"}], "\[IndentingNewLine]", 
 RowBox[{"gamma", "=", " ", 
  RowBox[{"1", "-", "alpha", "-", "beta"}]}]}], "Input",
 CellChangeTimes->{{3.992574093626837*^9, 3.992574102804495*^9}, {
  3.992574607381181*^9, 
  3.992574617576653*^9}},ExpressionUUID->"7815fe6b-80b7-43a1-8f51-\
9208268ca79c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"pMix", "[", "sigma", "]"}], "[", 
     RowBox[{"{", 
      RowBox[{
      "a", ",", "b", ",", "c", ",", "alpha", ",", "beta", ",", "gamma"}], 
      "}"}], "]"}], "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "3"}], ",", " ", "5"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.99257413326469*^9, 3.992574156398451*^9}, {
  3.992574239127331*^9, 3.992574261830099*^9}, {3.992574321150309*^9, 
  3.992574342863106*^9}},
