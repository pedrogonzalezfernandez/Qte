Cell["\<\
The next cell calculates the Interaction Potential V[x] as the sum of the \
Oscillator Potential V0[x] and the Perturbation W[x] (c.f. equations 27, 13, \
28 in the musmat article as well as Figure 5.)\
\>", "Text",
 CellChangeTimes->{{3.992573034967477*^9, 3.9925730760105124`*^9}, {
   3.992573245746047*^9, 3.992573297969474*^9}, {3.992573375103759*^9, 
   3.992573444666151*^9}, {3.99257384784009*^9, 3.992573893912764*^9}, 
   3.992574048682549*^9, 3.992574081843865*^9, {3.992575101736039*^9, 
   3.992575184341875*^9}, {3.992575618728243*^9, 3.992575716246941*^9}, {
   3.992576451183053*^9, 3.992576457653707*^9}},
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"93a06050-1a38-467e-a5b4-c1a562e4c2ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"E0", " ", "=", " ", 
   RowBox[{
    RowBox[{"36", " ", 
     RowBox[{
      RowBox[{"Log", "[", "2", "]"}], "/", 
      RowBox[{"(", 
       RowBox[{"Pi", "^", "2"}], ")"}]}]}], "//", "N"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"V0", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"E0", "^", "2"}], 
   RowBox[{"x", "^", "2"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"Sqrt", "[", 
    RowBox[{"E0", "/", "Pi"}], "]"}], 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", "E0"}], " ", 
     RowBox[{"x", "^", "2"}]}], "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"W", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"E0", "^", "2"}], "/", 
    RowBox[{"(", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
