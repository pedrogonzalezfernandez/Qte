Cell[BoxData[{
 RowBox[{
  StyleBox[
   RowBox[{
    RowBox[{"ThomasRound", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"Round", "[", 
       RowBox[{"100000", " ", "*", " ", "x"}], "]"}], "/", "100000"}], "//", 
     "N"}]}],
   FontColor->GrayLevel[0]], 
  StyleBox["\[IndentingNewLine]",
   FontColor->GrayLevel[0]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NotesEigenState", "[", "m_", "]"}], ":=", 
   RowBox[{"ThomasRound", "/@", 
    RowBox[{"Prepend", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"EigenState", "[", "m", "]"}], "[", 
         RowBox[{"k", " ", 
          RowBox[{"Pi", "/", "6"}]}], "]"}], ",", 
        RowBox[{"{", 
